# Names this project reads. Create .env with the key command
# in Chapter 8, Step 3. Never record .env in Git.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# Host names separated by commas; leave empty locally.
DJANGO_ALLOWED_HOSTS=
# The admin site's path, ending with /. Keep admin/ locally;
# choose a path that is hard to guess for each deployment.
DJANGO_ADMIN_URL=admin/
# Domains to accept although a disposable-address list
# names them, separated by commas; usually empty.
DJANGO_EMAIL_DOMAINS_ALLOWED=
# Sign-in with Google and GitHub (Chapter 27). Leave the
# client IDs empty to hide a provider's button.
DJANGO_GOOGLE_CLIENT_ID=
DJANGO_GOOGLE_SECRET=
DJANGO_GITHUB_CLIENT_ID=
DJANGO_GITHUB_SECRET=
